# --- Core ---
NODE_ENV=production
PORT=3000
# Absolute path to the SQLite file. In Docker this lives on the /data volume.
DATABASE_PATH=/data/app.db
# Trust X-Forwarded-For from the reverse proxy, so per-IP rate limits see the
# real client. On by default in production; set to false only if the container
# is reachable directly rather than through Coolify's proxy.
TRUST_PROXY=true
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- First admin (created on first boot only, when no users exist) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Registration ---
# Optional. Seeds one access code on first boot so the first staff member can register.
REGISTRATION_ACCESS_CODE=

# --- AI ---
ANTHROPIC_API_KEY=

# --- Email (optional). Email features stay hidden until these are set. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
